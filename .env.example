# Spotify app credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
# Must exactly match the callback registered in your Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Google sign-in (OAuth client of type "Web application"): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an authorized redirect URI on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback

# At least 32 random characters. Encrypts stored Spotify tokens; changing it forces everyone to reconnect Spotify.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-at-least-32-random-characters
# Postgres for profiles, sessions, Spotify connections, and share links.
# `docker compose -f docker-compose.dev.yml up -d` starts one matching this URL.
DATABASE_URL=postgres://retroplay:retroplay@127.0.0.1:5432/retroplay

API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
