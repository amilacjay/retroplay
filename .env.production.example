# Production settings for docker-compose.yml. On the server this lives at ~/apps/retroplay/.env (mode 600).
# Redirect URIs and WEB_ORIGIN are derived from SITE_ADDRESS by docker-compose.yml.

# Public hostname; Caddy gets a Let's Encrypt certificate for it.
SITE_ADDRESS=156-67-27-54.sslip.io

# Register https://<SITE_ADDRESS>/auth/callback in the Spotify dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Register https://<SITE_ADDRESS>/auth/google/callback on the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate each with: openssl rand -base64 36 | tr -d '/+='
APP_SECRET=
POSTGRES_PASSWORD=
