{
	email {$ACME_EMAIL}
}

# SITE_ADDRESS is the public hostname (e.g. 156-67-27-54.sslip.io); Caddy fetches and renews its Let's Encrypt certificate.
{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api/* /auth/*
	handle @backend {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Hashed build assets never change; everything else (index.html, share links) must stay fresh.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
