(app) {
	encode zstd gzip

	@backend path /api/* /auth/*
	handle @backend {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Hashed build assets never change; everything else (index.html, share links) must stay fresh.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# SITE_ADDRESS is the server's own hostname (e.g. 156-67-27-54.sslip.io); Caddy fetches and renews its Let's Encrypt certificate.
# When PUBLIC_HOST is a different name (a Cloudflare Tunnel domain), this address redirects there, so OAuth state cookies
# and callbacks always use one hostname.
{$SITE_ADDRESS} {
	@elsewhere not host {$PUBLIC_HOST}
	redir @elsewhere https://{$PUBLIC_HOST}{uri} 308
	import app
}

# Cloudflare Tunnel origin: cloudflared connects over the internal network as http://web:80 and Cloudflare terminates TLS.
http://{$TUNNEL_HOSTNAME:tunnel.invalid} {
	import app
}
